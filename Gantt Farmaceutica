<script>
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        const isAdmin = urlParams.get('admin') === 'true';
        const dataParam = urlParams.get('state');

        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        const modeIndicator = document.getElementById('mode-indicator');
        const btnReset = document.getElementById('btn-reset');

        // 1. Cargar estados desde la URL (si existe el parámetro state) o desde localStorage
        let stateObj = {};
        if (dataParam) {
            try {
                stateObj = JSON.parse(atob(dataParam));
            } catch (e) {
                console.error("Error al leer estado");
            }
        } else {
            checkboxes.forEach(box => {
                if (localStorage.getItem(box.id) === "true") stateObj[box.id] = true;
            });
        }

        // 2. Aplicar estados a los checkboxes
        checkboxes.forEach(box => {
            if (stateObj[box.id]) {
                box.checked = true;
                toggleCompletedStyles(box);
            }
        });

        if (isAdmin) {
            document.body.classList.remove('viewer-mode');
            modeIndicator.innerText = "⚡ Modo Administrador (Sincronizado)";
            modeIndicator.classList.add('admin');
            btnReset.style.display = "inline-block";

            // Escuchar cambios para actualizar URL y localStorage en tiempo real
            checkboxes.forEach(box => {
                box.addEventListener('change', function() {
                    toggleCompletedStyles(this);
                    updatePercentages();
                    saveAdminState();
                });
            });
        }

        updatePercentages();
    });

    function toggleCompletedStyles(checkbox) {
        const taskName = checkbox.closest('.gantt-row').querySelector('.task-name');
        const block = checkbox.closest('.gantt-block');
        
        if(checkbox.checked) {
            taskName.classList.add('completed');
            block.classList.add('completed');
        } else {
            taskName.classList.remove('completed');
            block.classList.remove('completed');
        }
    }

    function updatePercentages() {
        const mediums = [
            'profar-google', 'profar-meta', 
            'lavoval-google', 'lavoval-meta', 
            'clinical-google', 'clinical-meta'
        ];

        mediums.forEach(medium => {
            const boxes = document.querySelectorAll(`input[data-medium="${medium}"]`);
            const checked = document.querySelectorAll(`input[data-medium="${medium}"]:checked`);
            
            if (boxes.length > 0) {
                const percentage = Math.round((checked.length / boxes.length) * 100);
                document.getElementById(`pct-${medium}`).innerText = percentage + '%';
            }
        });
    }

    // Codifica todos los checks activos en un parámetro seguro dentro de la URL
    function saveAdminState() {
        const checkboxes = document.querySelectorAll('input[type="checkbox"]');
        let stateObj = {};
        
        checkboxes.forEach(box => {
            if (box.checked) {
                stateObj[box.id] = true;
                localStorage.setItem(box.id, "true");
            } else {
                localStorage.removeItem(box.id);
            }
        });

        const encodedState = btoa(JSON.stringify(stateObj));
        const newUrl = `${window.location.pathname}?admin=true&state=${encodedState}`;
        window.history.replaceState({}, '', newUrl);
    }

    function resetData() {
        if(confirm("¿Estás seguro de reiniciar todo el progreso de la auditoría?")) {
            localStorage.clear();
            window.location.href = `${window.location.pathname}?admin=true`;
        }
    }
</script>

